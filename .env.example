# =============================================================================
# Humaniza Acadêmico — variáveis de ambiente
#
# COPIE para `.env` e preencha. O arquivo `.env` é ignorado pelo git.
# NENHUMA chave tem valor padrão no código: um provedor sem chave é
# reportado como indisponível, nunca como "funcionando".
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_NAME="Humaniza Acadêmico"
APP_VERSION="0.1.0"
ENVIRONMENT=local
DEBUG=false
API_PREFIX=/api/v1

# --- Servidor ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Lista separada por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistência ------------------------------------------------------------
# Desenvolvimento: SQLite. Produção: postgresql+psycopg://usuario:senha@host:5432/humaniza
DATABASE_URL=sqlite:///./data/app.db
SQL_ECHO=false

# --- Armazenamento -----------------------------------------------------------
STORAGE_DIR=./data
MAX_UPLOAD_BYTES=10485760

# --- LLM: geral --------------------------------------------------------------
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=8192

# --- LLM: OpenAI -------------------------------------------------------------
# Opcional. Sem esta chave, o provedor OpenAI aparece como indisponível.
OPENAI_API_KEY=

# --- LLM: Anthropic (Claude) -------------------------------------------------
ANTHROPIC_API_KEY=

# --- LLM: Google Gemini ------------------------------------------------------
GEMINI_API_KEY=

# --- LLM: Ollama (local, sem chave) -------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- LLM: endpoint compatível com a API da OpenAI ----------------------------
# Ex.: LM Studio, vLLM, gateway corporativo.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODELS=

# --- LLM: indireção para cofre externo -----------------------------------------
# Em vez da chave, informe o NOME da variável em que o cofre (Vault Agent,
# External Secrets, Docker/K8s) injeta o segredo. Lida a cada uso (rotação sem
# reinício). O valor direto *_API_KEY tem precedência. Nomes reservados como
# SECRET_KEY/ENCRYPTION_KEY/DATABASE_URL são rejeitados.
OPENAI_API_KEY_ENV_NAME=
ANTHROPIC_API_KEY_ENV_NAME=
GEMINI_API_KEY_ENV_NAME=
OPENAI_COMPATIBLE_API_KEY_ENV_NAME=
# Ou: caminho ABSOLUTO de um arquivo com a chave (Docker/K8s secrets), ex.:
# /run/secrets/openai_api_key. Usado só se *_API_KEY e *_ENV_NAME estiverem vazios.
OPENAI_API_KEY_FILE=
ANTHROPIC_API_KEY_FILE=
GEMINI_API_KEY_FILE=
OPENAI_COMPATIBLE_API_KEY_FILE=

# --- Consulta externa de metadados (opt-in) ----------------------------------
# Desligado por padrão: nunca envia o documento a serviços externos.
ENABLE_DOI_LOOKUP=false
DOI_LOOKUP_TIMEOUT_SECONDS=15
DOI_USER_AGENT="HumanizaAcademico/0.1 (+mailto:contato@example.org)"

# --- Documentos --------------------------------------------------------------
TEMPLATES_DIR=../templates
EXPORT_DIR=./data/exports
# Renderizador de PDF: libreoffice | docx2pdf | none
PDF_RENDERER=libreoffice
LIBREOFFICE_BINARY=soffice

# --- Segurança ---------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ATENÇÃO: em produção, use um cofre de segredos, NÃO este arquivo.
SECRET_KEY=
# Chaves de assinatura anteriores (CSV ou lista JSON) aceitas durante janela de rotação.
PREVIOUS_SECRET_KEYS=

# Autenticação e isolamento por usuário (obrigatório em produção).
AUTH_ENABLED=false
# Revogação de tokens (logout): database (compartilhada e persistente) | memory
REVOCATION_BACKEND=database
ACCESS_TOKEN_TTL_SECONDS=3600

# Limites de requisições por minuto (por IP) e backend: memory (por processo) |
# sqlite (workers do mesmo host, em STORAGE_DIR/ratelimit.db) |
# redis (vários nós; exige REDIS_URL e `pip install -e ".[redis]"`)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_HUMANIZE_PER_MINUTE=30
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# Defina true apenas quando a aplicação estiver atrás de um proxy reverso
# confiável que injete X-Forwarded-For. Com false, o rate limiter usa o IP
# direto da conexão (evita bypass por falsificação do cabeçalho).
BEHIND_PROXY=false
# Quantos proxies confiáveis anexam entradas ao X-Forwarded-For (1 = um Nginx).
TRUSTED_PROXY_HOPS=1

# Chave de criptografia autenticada (AES-GCM) para credenciais persistidas.
# 32 bytes em base64. Gere com:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ATENÇÃO: em produção, use um cofre de segredos.
ENCRYPTION_KEY=
PREVIOUS_ENCRYPTION_KEYS=
CREDENTIAL_ENCRYPTION_ENABLED=false

# Política de retenção de documentos (dias) e intervalo de varredura automática (s, 0 = desligada).
DOCUMENT_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_SECONDS=0
